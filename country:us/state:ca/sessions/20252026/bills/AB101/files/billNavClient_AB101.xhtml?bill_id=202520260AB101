                  </table><style>span.DottedLeaders::after {content:"..................";}</style><font color="#B30000"><s><caml:BudgetItem id="id_D5AA7348-9A3C-4277-B3CB-081D221BB076" num="3900-101-3228"><caml:Content><table class="Abutted" id="id_C2DF805D-5607-4387-8B18-B0C035ECE806"
                  width="416" cellspacing="0"><tbody><tr style="keep-together.within-page:always;"><td colspan="7" width="326" valign="top"><p
                  class="Stub"><caml:NumSpan>3900-101-3228</caml:NumSpan>—For local assistance, State Air Resources Board, payable from the
                  Greenhouse Gas Reduction Fund<span class="DottedLeaders"/></s></p><div style="margin:0 0 1em 0;"></div></td><td width="80"
                  align="right" valign="bottom">465,000,000</td></tr><tr style="keep-with-next.within-page:always;"><td width="24" valign="top"/><td
                  colspan="6" width="312" valign="top"><p class="Justify10Point">Schedule:</s></p><div style="margin:0 0 1em 0;"></div></td><td
                  width="80" valign="bottom"/></tr><tr style="keep-together.within-page:always;"><td width="24" valign="top"/><td width="24"
                  valign="top">(.5)</td><td colspan="4" width="214" valign="top" style="keep-together.within-page:always;"><p class="Justify10Point">3510-Climate
                  Change<span class="DottedLeaders"/></s></p><div style="margin:0 0 1em 0;"></div></td><td width="74" align="right" valign="bottom">215,000,000</td><td
                  width="80" valign="bottom"/></tr><tr style="keep-together.within-page:always;"><td width="24" valign="top"/><td width="24"
                  valign="top">(1)</td><td colspan="4" width="214" valign="top" style="keep-together.within-page:always;"><p class="Justify10Point">3530-Community
                  Air Protection<span class="DottedLeaders"/></s></p><div style="margin:0 0 1em 0;"></div></td><td width="74" align="right"
                  valign="bottom">250,000,000</td><td width="80" valign="bottom"/></tr><tr style="keep-with-next.within-page:always;"><td width="24"
                  valign="top"/><td colspan="6" width="312" valign="top"><p class="Justify10Point">Provisions:</s></p><div style="margin:0 0
                  1em 0;"></div></td><td width="80" valign="bottom"/></tr><tr><td width="24" valign="top"/><td width="24" valign="top">1.</td><td
                  colspan="5" width="288" valign="top"><p class="Justify10Point">The funds appropriated in Schedule (.5) shall be used as follows:</s></p><div
                  style="margin:0 0 1em 0;"></div></td><td width="80" valign="bottom"/></tr><tr><td width="24" valign="top"/><td width="24"
                  valign="top"/><td width="24" valign="top">(a)</td><td colspan="4" width="264" valign="top"><p class="Justify10Point">$20,000,000
                  shall be made available to reduce emissions from commercial harbor craft subject to regulation by the board. In awarding funds,
                  the board shall consider prioritizing projects based on maximizing emission reductions consistent with the commercial harbor
                  craft regulation. The board shall prioritize private ferry operators regulated by the Public Utilities Commission, public
                  ferries, licensed commercial passenger fishing vessels, research vessels, and excursion vessels.</s></p><div style="margin:0
                  0 1em 0;"></div></td><td width="80" valign="bottom"/></tr><tr><td width="24" valign="top"/><td width="24" valign="top"/><td
                  width="24" valign="top">(b)</td><td colspan="4" width="264" valign="top"><p class="Justify10Point">$48,000,000 for zero-emission
                  drayage trucks to be administered through the Hybrid and Zero-Emission Truck and Bus Voucher Incentive Project.</s></p><div
                  style="margin:0 0 1em 0;"></div></td><td width="80" valign="bottom"/></tr><tr><td width="24" valign="top"/><td width="24"
                  valign="top"/><td width="24" valign="top">(c)</td><td colspan="4" width="264" valign="top"><p class="Justify10Point">$100,000,000
                  shall be used for sustainable community-based transportation equity projects established under the Charge Ahead California
                  Initiative, which increase access to zero-emission mobility in low-income communities and air pollution.</s></p><div style="margin:0
                  0 1em 0;"></div></td><td width="80" valign="bottom"/></tr><tr><td width="24" valign="top"/><td width="24" valign="top"/><td
                  width="24" valign="top">(d)</td><td colspan="4" width="264" valign="top"><p class="Justify10Point">$47,000,000 shall be used
                  for emerging opportunities within zero-emission vehicles or equipment, zero-emission vehicle or equipment components, and
                  zero-emission vehicle charging or refueling equipment, established under Section 39719.2 of the Health and Safety Code.</s></p><div
                  style="margin:0 0 1em 0;"></div></td><td width="80" valign="bottom"/></tr><tr><td width="24" valign="top"/><td width="24"
                  valign="top">2.</td><td colspan="5" width="288" valign="top"><p class="Justify10Point">The funds appropriated in Schedule
                  (1) shall be used as follows:</s></p><div style="margin:0 0 1em 0;"></div></td><td width="80" valign="bottom"/></tr><tr><td
                  width="24" valign="top"/><td width="24" valign="top"/><td width="24" valign="top">(a)</td><td colspan="4" width="264" valign="top"><p
                  class="Justify10Point">$195,000,000 shall be available for financial incentives to reduce mobile and stationary sources of
                  criteria air pollutants or toxic air contaminants consistent with community emissions reduction programs developed pursuant
                  to Section 44391.2 of the Health and Safety Code.</s></p><div style="margin:0 0 1em 0;"></div></td><td width="80" valign="bottom"/></tr><tr><td
                  width="24" valign="top"/><td width="24" valign="top"/><td width="24" valign="top">(b)</td><td colspan="4" width="264" valign="top"><p
                  class="Justify10Point">$50,000,000 shall be available to support local air districts’ implementation of Chapter 136 of the
                  Statutes of 2017, notwithstanding any other law.</s></p><div style="margin:0 0 1em 0;"></div></td><td width="80" valign="bottom"/></tr><tr><td
                  width="24" valign="top"/><td width="24" valign="top"/><td width="24" valign="top">(c)</td><td colspan="4" width="264" valign="top"><p
                  class="Justify10Point">$5,000,000 shall be used for technical assistance grants to community-based organizations pursuant
                  to subdivision (d) of Section 44391.2 of the Health and Safety Code. These grants may be used to support community participation,
                  including activities that enable meeting attendance, consistent with State Air Resources Board grant guidelines and agreements,
                  in the implementation of subdivision (d) of Section 44391.2 and Section 42705.5 of the Health and Safety Code.</s></p><div
                  style="margin:0 0 1em 0;"></div></td><td width="80" valign="bottom"/></tr><tr><td width="24" valign="top"/><td width="24"
                  valign="top">3.</td><td colspan="5" width="288" valign="top"><p class="Justify10Point">The funds appropriated in this item
                  shall be subject to the provisions of Section 15.14.</s></p><div style="margin:0 0 1em 0;"></div></td><td width="80" valign="bottom"/></tr><tr><td
                  width="24" valign="top"/><td width="24" valign="top">4.</td><td colspan="5" width="288" valign="top"><p class="Justify10Point">Not
                  more than 5 percent of the amounts appropriated in this item may be used for administrative costs. The funds in this item
                  shall be available for encumbrance or expenditure until June 30, 2028, and shall be available for liquidation until June 30,
                  2030.</s></p><div style="margin:0 0 1em 0;"></div></td><td width="80" valign="bottom"/></tr></tbody></table></caml:Content></caml:BudgetItem></s></font>
